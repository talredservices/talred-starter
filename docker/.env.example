# The standalone Docker stack is isolated under this Compose project name.
COMPOSE_PROJECT_NAME=talred-starter
LOCAL_UID=
LOCAL_GID=

# Change these if another local stack already uses the standard ports.
IDENTITY_API_PORT=8201
IDENTITY_CONSOLE_PORT=3201
STARTER_WEB_PORT=3300
STARTER_API_PORT=8300

APP_ENV=local
APP_DEBUG=true

# The setup script fills these from runtime/identity/.env.release.example.
TALRED_IDENTITY_RELEASE=
TALRED_IDENTITY_SOURCE_CONTEXT=
TALRED_IDENTITY_SERVER_IMAGE=
TALRED_IDENTITY_NGINX_IMAGE=

# Local-only credentials are generated into the ignored root .env file.
MYSQL_USER=starter
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
IDENTITY_APP_KEY=
STARTER_API_APP_KEY=
STARTER_IDENTITY_OWNER_EMAIL=owner@talredservices.com
STARTER_IDENTITY_OWNER_NAME=Starter Local Owner
STARTER_IDENTITY_OWNER_PASSWORD=
STARTER_IDENTITY_CONSOLE_CLIENT_ID=
STARTER_IDENTITY_CONSOLE_CLIENT_SECRET=
STARTER_IDENTITY_CONSOLE_SESSION_PASSWORD=
STARTER_WEB_SESSION_PASSWORD=
STARTER_IDENTITY_HOSTED_APPLICATIONS_TOKEN=
STARTER_IDENTITY_SESSION_SECRET=
