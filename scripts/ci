#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$root"

run_with_stack_paused() {
  local wrapper="$root/../local-dev-ops/scripts/with-stack-paused"
  if [[ -x "$wrapper" ]]; then
    "$wrapper" -- "$@"
  else
    "$@"
  fi
}

web() {
  cd "$root/apps/web"
  CI=true pnpm install --frozen-lockfile
  run_with_stack_paused pnpm lint
  pnpm test
  node "$root/scripts/tests/audit-web-dependencies.test.mjs"
  run_with_stack_paused pnpm build
  pnpm run audit
}


php_app() {
  local app="$1"
  cd "$root/$app"
  for extension in pdo_sqlite sqlite3 gd; do
    php -m | grep -Fxq "$extension" || {
      echo "PHP extension is required by the GitHub test job: $extension" >&2
      return 78
    }
  done
  composer validate --strict
  composer install --prefer-dist --no-interaction --no-progress
  composer test
  composer audit
}

fast() {
  cd "$root"
  git diff --check
  ./scripts/check-tracked-secrets.sh
  python3 scripts/check-release-tree.py
  php -l scripts/init-stack.php
  ./scripts/init-stack --help
  bash -n scripts/init-stack docker/up.sh docker/down.sh docker/credentials.sh docker/mysql/initialize-databases.sh
  docker --context default compose --env-file docker/.env.example --env-file runtime/identity/.env.release.example -f docker/compose.yaml config --quiet
  web
  python3 "$root/scripts/validate-identity-release.py"
  php_app apps/api
}

case "${1:-pre-push}" in
  fast|pre-push) fast ;;
  full) fast ;;
  *) echo "Usage: $0 {fast|pre-push|full}" >&2; exit 64 ;;
esac
