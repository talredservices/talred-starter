# At least 32 characters. Use a distinct value for every deployed application.
NUXT_TALRED_IDENTITY_SESSION_SECRET=replace-with-a-long-random-secret
# Generate one with: npx nuxt-og-image generate-secret
NUXT_OG_IMAGE_SECRET=<secret>
ZOLTA_STARTER_SITE_URL=http://localhost:3000

# Create this confidential client in the shared Talred Identity console, then copy its values here.
NUXT_TALRED_IDENTITY_APPLICATIONS_STARTER_IDENTITY_API_URL=http://localhost:8100
NUXT_TALRED_IDENTITY_APPLICATIONS_STARTER_HOSTED_AUTH_URL=http://localhost:3100
NUXT_TALRED_IDENTITY_APPLICATIONS_STARTER_HOSTED_APPLICATION=zoltasoft-starter
NUXT_TALRED_IDENTITY_APPLICATIONS_STARTER_CLIENT_ID=
NUXT_TALRED_IDENTITY_APPLICATIONS_STARTER_CLIENT_SECRET=
NUXT_TALRED_IDENTITY_APPLICATIONS_STARTER_CALLBACK_URL=http://localhost:3000/api/identity/starter/auth/callback
