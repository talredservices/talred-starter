{
  "$schema": "https://www.schemastore.org/package.json",
  "name": "@talred/starter-web",
  "version": "0.1.0-beta.1",
  "description": "Nuxt client and BFF for the Talred Starter reference stack.",
  "type": "module",
  "private": true,
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "pnpm run lint:js && pnpm run lint:types",
    "lint:js": "eslint --max-warnings=0 --report-unused-disable-directives \"{app,layers,packages,server,shared}/**/*.{js,ts,vue}\"",
    "lint:types": "tsc --build --force --pretty",
    "format": "eslint --fix --max-warnings=0 --report-unused-disable-directives \"{app,layers,packages,server,shared}/**/*.{js,ts,vue}\" \"*.{ts,mjs}\"",
    "format:check": "eslint --max-warnings=0 --report-unused-disable-directives \"{app,layers,packages,server,shared}/**/*.{js,ts,vue}\" \"*.{ts,mjs}\"",
    "test": "vitest run",
    "audit": "node ../../scripts/audit-web-dependencies.mjs"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.125",
    "@iconify-json/simple-icons": "^1.2.99",
    "@nuxt/content": "^3.15.2",
    "@nuxt/image": "^1.11.0",
    "@nuxt/ui": "^4.11.0",
    "@nuxtjs/i18n": "^10.6.0",
    "@talred/api-client": "0.1.0-beta.3",
    "@talred/identity-consumer-nuxt": "0.1.0-beta.15",
    "@vueuse/core": "^14.4.0",
    "@vueuse/nuxt": "^14.4.0",
    "debug": "^4.4.3",
    "extend": "^3.0.2",
    "lru-cache": "^11.5.2",
    "motion-v": "^1.10.3",
    "nuxt": "^4.6.0",
    "nuxt-auth-utils": "0.5.30",
    "nuxt-csurf": "^1.6.6",
    "nuxt-og-image": "^6.7.8",
    "parse5": "^8.0.1",
    "redis": "^5.12.1",
    "rehype-raw": "^7.0.0",
    "remark-emoji": "^5.0.2",
    "remark-gfm": "^4.0.1",
    "remark-mdc": "^3.11.1",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "vue": "^3.5.43",
    "vue-router": "^5.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "eslint": "^10.9.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@11.21.0"
}
